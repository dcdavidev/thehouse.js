{
  "name": "@dcdavidev/thehouse",
  "version": "1.1.0",
  "description": "Trapped inside a haunted house with no memory of how you got there. A terminal-based interactive horror adventure—every choice counts if you want to make it out alive.",
  "keywords": [
    "horror",
    "game",
    "text-based",
    "adventure",
    "cli",
    "interactive-fiction",
    "survival"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcdavidev/thehouse.js.git"
  },
  "license": "MIT",
  "author": "Davide Di Criscito <dcdavidev@gmail.com>",
  "sideEffects": [
    "./dist/cli.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./terminal": {
      "types": "./dist/terminal/index.d.ts",
      "import": "./dist/terminal/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "thehouse": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "check:ci": "pnpm run lint:check && pnpm run fmt:check && pnpm run typecheck && pnpm run test",
    "commit": "cz",
    "commit:lint": "commitlint --from=HEAD~1",
    "dev": "tsx src/cli.ts",
    "fmt": "prettier --ignore-unknown --write .",
    "fmt:check": "prettier --ignore-unknown --check .",
    "lint": "eslint --no-warn-ignored --fix .",
    "lint:check": "eslint --no-warn-ignored .",
    "play": "tsx src/cli.ts",
    "prepare": "lefthook install",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "dependencies": {
    "@inquirer/prompts": "^8.8.0",
    "chalk": "^6.0.1",
    "string-width": "^9.0.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@spellbookx/recipes": "^1.3.0",
    "@types/node": "^26.6.6",
    "commitizen": "^4.3.2",
    "commitlint-config-spellbookx": "^1.3.0",
    "cz-git": "^1.14.0",
    "eslint": "^10.15.0",
    "eslint-plugin-spellbookx": "^1.3.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "prettier-config-spellbookx": "^1.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
